<style>
/* Reset básico para o link do sidebar */
.sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    text-decoration: none;
    color: inherit;
    /* Reserva espaço da borda para evitar deslocamento */
    border-left: 4px solid transparent; 
    /* Transição suave usando Bézier */
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    will-change: transform, background, border-left-color;
    position: relative;
    overflow: hidden; /* Garante que nada vaze */
}

/* Ícones */
.sidebar-nav a i {
    width: 24px; /* Largura fixa para o ícone */
    text-align: center;
    flex-shrink: 0; /* Impede que o ícone seja esmagado */
    transition: color 0.3s ease, text-shadow 0.3s ease;
}

/* Títulos do Menu - A MÁGICA ESTÁ AQUI */
.sidebar-nav a span {
    white-space: nowrap; /* CRÍTICO: Impede que o texto quebre linha */
    overflow: hidden;    /* Esconde o texto se não houver espaço */
    text-overflow: ellipsis; /* Adiciona ... se o texto for cortado */
    transition: color 0.3s ease;
    letter-spacing: 0.3px;
}

/* Estado Hover (Passar o mouse) - Não ativo */
.sidebar-nav a:not(.active):hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(5px);
    color: #fff;
}

.sidebar-nav a:not(.active):hover i {
    color: #fff;
    transform: scale(1.1);
}

/* Estado Ativo */
.sidebar-nav a.active {
    background: linear-gradient(90deg, rgba(255, 215, 0, 0.15) 0%, rgba(255, 215, 0, 0.01) 100%) !important;
    border-left-color: var(--accent-gold) !important;
    color: var(--accent-gold) !important;
    font-weight: normal; /* Mantém peso normal para não mudar largura */
    text-shadow: 0 0 1px rgba(255, 215, 0, 0.5);
    transform: translateX(5px) !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15) !important;
}

.sidebar-nav a.active i {
    color: var(--accent-gold) !important;
    text-shadow: 0 0 12px rgba(255, 215, 0, 0.6) !important;
    animation: pulseIcon 2s infinite ease-in-out;
}

.sidebar-nav a.active span {
    color: var(--accent-gold) !important;
}

/* Animação sutil no ícone ativo */
@keyframes pulseIcon {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}
</style>