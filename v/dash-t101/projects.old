<?php
session_start();
require_once __DIR__ . '/../config/database.php';
require_once __DIR__ . '/../config/dash_database.php';
require_once __DIR__ . '/../config/dash_functions.php';

// Verificar se o usuário está logado
if (!isLoggedIn()) {
    header('Location: /login.php?redirect=' . urlencode($_SERVER['REQUEST_URI']));
    exit;
}

$page_title = 'Projetos - Dash-T101';
$user_id = $_SESSION['user_id'];
$message = '';
$error = '';

// Listas de dados para popular o modal
$languages = ['pt' => 'Português', 'en' => 'Inglês', 'es' => 'Espanhol', 'fr' => 'Francês', 'de' => 'Alemão', 'it' => 'Italiano', 'ja' => 'Japonês', 'ko' => 'Coreano', 'zh' => 'Chinês', 'ru' => 'Russo', 'ar' => 'Árabe'];
$unit_types = ['palavra' => 'Palavra', 'caracteres' => 'Caracteres', 'hora' => 'Hora', 'minuto' => 'Minuto', 'lauda' => 'Lauda', 'diaria' => 'Diária'];
$service_types_list = ['traducao' => 'Tradução', 'revisao' => 'Revisão', 'localizacao' => 'Localização', 'interpretacao' => 'Interpretação', 'transcricao' => 'Transcrição', 'other' => 'Outros'];

// Lógica para seleção do freelancer recém-adicionado (pós-redirect)
$last_added_freelancer_id = null;
if (isset($_SESSION['last_added_freelancer_id'])) {
    $last_added_freelancer_id = $_SESSION['last_added_freelancer_id'];
    $message = isset($_SESSION['temp_message']) ? $_SESSION['temp_message'] : "Novo fornecedor adicionado e selecionado.";
    unset($_SESSION['last_added_freelancer_id']);
    if (isset($_SESSION['temp_message'])) unset($_SESSION['temp_message']);
}


// Processar adição de novo serviço
$new_service_added = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['new_service_type']) && !empty($_POST['new_service_type'])) {
    $new_service = trim($_POST['new_service_type']);
    if (!empty($new_service)) {
        if (!isset($_SESSION['custom_services'])) {
            $_SESSION['custom_services'] = [];
        }
        $normalized_new_service = strtolower($new_service);
        $normalized_custom_services = array_map('strtolower', $_SESSION['custom_services']);

        if (!in_array($normalized_new_service, $normalized_custom_services)) {
            $_SESSION['custom_services'][] = $new_service;
            $new_service_added = $new_service;
            $message = "Novo serviço adicionado.";
        } else {
            $new_service_added = $new_service;
            $message = "Serviço '$new_service' já existe na lista.";
        }
    }
}

// Processar ações de ADIÇÃO e EDIÇÃO
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['action'])) {
        
        // --- INÍCIO: Captura de Campos de Interpretação ---
        $is_interpretation_service = (isset($_POST['service_type']) && $_POST['service_type'] === 'interpretacao');
        $interpretation_type = $_POST['interpretation_type'] ?? 'online';
        $location_address = $_POST['location_address'] ?? null;
        $access_link = $_POST['access_link'] ?? null;
        $start_time = !empty($_POST['start_time']) ? $_POST['start_time'] : null;
        $end_time = !empty($_POST['end_time']) ? $_POST['end_time'] : null;
        $timezone = $_POST['timezone'] ?? 'America/Sao_Paulo';
        $hourly_rate = !empty($_POST['hourly_rate']) ? (float)$_POST['hourly_rate'] : 0.00;
        $daily_rate = !empty($_POST['daily_rate']) ? (float)$_POST['daily_rate'] : 0.00;
        $extra_costs = !empty($_POST['extra_costs']) ? (float)$_POST['extra_costs'] : 0.00;
        $extra_costs_description = $_POST['extra_costs_description'] ?? null;
        $equipment_units = !empty($_POST['equipment_units']) ? (int)$_POST['equipment_units'] : 0;
        $equipment_rate = !empty($_POST['equipment_rate']) ? (float)$_POST['equipment_rate'] : 0.00;
        // --- FIM: Captura de Campos de Interpretação ---
        
        // [NOVO] Captura de Campos de Custo (Job)
        $freelancer_id = !empty($_POST['freelancer_id']) ? $_POST['freelancer_id'] : null;
        $freelancer_rate = !empty($_POST['rate_per_word_freelancer']) ? (float)$_POST['rate_per_word_freelancer'] : 0.00;
        $freelancer_currency = $_POST['currency_freelancer'] ?? 'BRL';

        switch ($_POST['action']) {
            case 'add_client':
                try {
                    $company_name = trim($_POST['company_name']); 
                    $default_currency = $_POST['default_currency'];
                    if (!empty($company_name)) {
                        $stmt = $pdo->prepare("INSERT INTO dash_clients (user_id, name, company, default_currency) VALUES (?, ?, ?, ?)");
                        $stmt->execute([$user_id, $company_name, $company_name, $default_currency]);
                        
                        $_SESSION['last_added_client_id'] = $pdo->lastInsertId();
                        $_SESSION['temp_message'] = "Cliente adicionado.";
                    } else {
                        $_SESSION['temp_error'] = "O nome do cliente não pode estar vazio.";
                    }
                } catch (PDOException $e) {
                    $_SESSION['temp_error'] = 'Erro ao adicionar cliente: ' . $e->getMessage();
                }
                header("Location: projects.php"); // Recarrega a página de adição
                exit;
                break;

            case 'add_project':
                try {
                    $pdo->beginTransaction(); // Inicia transação

                    $unit_type = $_POST['unit_type'] ?? 'palavra';
                    $quantity = floatval($_POST['quantity'] ?? 0);
                    $rate_per_unit = floatval($_POST['rate_per_unit'] ?? 0);
                    $daily_target = floatval($_POST['daily_target'] ?? 0);
                    $lauda_size = intval($_POST['lauda_size'] ?? 0);
                    $lauda_unit = $_POST['lauda_unit'] ?? 'palavras';
                    $project_deadline = $_POST['due_date'] ?: null; 

                    $negotiated_amount = floatval(str_replace(',', '.', $_POST['negotiated_value'] ?? '0'));
                    $calculated_amount = $quantity * $rate_per_unit;
                    $total_amount = ($negotiated_amount > 0) ? $negotiated_amount : $calculated_amount;
                    
                    $stmt = $pdo->prepare("INSERT INTO dash_projects (user_id, client_id, title, po_number, description, source_language, target_language, service_type, word_count, rate_per_word, total_amount, currency, status, priority, start_date, deadline, payment_date, notes, daily_word_target, unit_type, lauda_size, lauda_unit) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
                    $result = $stmt->execute([
                        $user_id, $_POST['client_id'], $_POST['project_name'], $_POST['po_number'] ?? null, $_POST['description'] ?? '', $_POST['source_lang'], $_POST['target_lang'], $_POST['service_type'], $quantity, $rate_per_unit, $total_amount, $_POST['currency'], $_POST['status'], $_POST['priority'], $_POST['start_date'] ?: null, $project_deadline, $_POST['payment_date'] ?: null, $_POST['notes'] ?? '', $daily_target, $unit_type, $lauda_size, $lauda_unit
                    ]);
                    
                    $new_project_id = $pdo->lastInsertId();

                    // --- INÍCIO: Lógica de Interpretação (ADD) ---
                    if ($result && $is_interpretation_service) {
                        $stmt_interp = $pdo->prepare("INSERT INTO dash_interpretation_details (project_id, user_id, interpretation_type, location_address, access_link, start_time, end_time, timezone, hourly_rate, daily_rate, extra_costs, extra_costs_description, equipment_units, equipment_rate) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
                        $stmt_interp->execute([$new_project_id, $user_id, $interpretation_type, $location_address, $access_link, $start_time, $end_time, $timezone, $hourly_rate, $daily_rate, $extra_costs, $extra_costs_description, $equipment_units, $equipment_rate]);
                    }
                    // --- FIM: Lógica de Interpretação (ADD) ---
                    
                    // [NOVO] INÍCIO: Lógica de Custo (Job) (ADD)
                    if ($new_project_id && $freelancer_id && $freelancer_rate > 0) {
                        $total_cost = $quantity * $freelancer_rate;
                        $job_status = 'pending'; // Status padrão
                        
                        $stmt_job = $pdo->prepare(
                            "INSERT INTO dash_jobs (user_id, project_id, freelancer_id, service_type, unit_type, quantity, rate, currency, total_cost, deadline, status) 
                             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
                        );
                        $stmt_job->execute([
                            $user_id, $new_project_id, $freelancer_id, $_POST['service_type'], $unit_type, $quantity, $freelancer_rate, $freelancer_currency, $total_cost, $project_deadline, $job_status
                        ]);
                    }
                    // [NOVO] FIM: Lógica de Custo (Job) (ADD)

                    $pdo->commit(); // Confirma transação
                    if ($result) { 
                        $_SESSION['temp_message'] = 'Projeto adicionado com sucesso!';
                        header("Location: projects_list.php"); // Redireciona para a lista
                        exit;
                    } else { 
                        $error = 'Erro ao adicionar projeto.'; 
                    }

                } catch (PDOException $e) { 
                    $pdo->rollBack(); // Desfaz em caso de erro
                    $error = 'Erro: ' . $e->getMessage(); 
                }
                break;

            case 'edit_project':
                try {
                    $pdo->beginTransaction(); // Inicia transação
                    $project_id_edit = $_POST['project_id'];

                    $unit_type = $_POST['unit_type'] ?? 'palavra';
                    $quantity = floatval($_POST['quantity'] ?? 0);
                    $rate_per_unit = floatval($_POST['rate_per_unit'] ?? 0);
                    $daily_target = floatval($_POST['daily_target'] ?? 0);
                    $lauda_size = intval($_POST['lauda_size'] ?? 0);
                    $lauda_unit = $_POST['lauda_unit'] ?? 'palavras';
                    $project_deadline = $_POST['due_date'] ?: null; 

                    $negotiated_amount = floatval(str_replace(',', '.', $_POST['negotiated_value'] ?? '0'));
                    $calculated_amount = $quantity * $rate_per_unit;
                    $total_amount = ($negotiated_amount > 0) ? $negotiated_amount : $calculated_amount;
                    
                    $stmt = $pdo->prepare("UPDATE dash_projects SET client_id = ?, title = ?, po_number = ?, description = ?, source_language = ?, target_language = ?, service_type = ?, word_count = ?, rate_per_word = ?, total_amount = ?, currency = ?, status = ?, priority = ?, start_date = ?, deadline = ?, payment_date = ?, notes = ?, daily_word_target = ?, unit_type = ?, lauda_size = ?, lauda_unit = ? WHERE id = ? AND user_id = ?"); 
                    $result = $stmt->execute([
                        $_POST['client_id'], $_POST['project_name'], $_POST['po_number'] ?? null, $_POST['description'] ?? '', $_POST['source_lang'], $_POST['target_lang'], $_POST['service_type'], $quantity, $rate_per_unit, $total_amount, $_POST['currency'], $_POST['status'], $_POST['priority'], $_POST['start_date'] ?: null, $project_deadline, $_POST['payment_date'] ?: null, $_POST['notes'] ?? '', $daily_target, $unit_type, $lauda_size, $lauda_unit,
                        $project_id_edit, $user_id
                    ]);

                    // --- INÍCIO: Lógica de Interpretação (EDIT) ---
                    if ($is_interpretation_service) {
                        $stmt_interp = $pdo->prepare("
                            INSERT INTO dash_interpretation_details (project_id, user_id, interpretation_type, location_address, access_link, start_time, end_time, timezone, hourly_rate, daily_rate, extra_costs, extra_costs_description, equipment_units, equipment_rate) 
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                            ON DUPLICATE KEY UPDATE
                                interpretation_type = VALUES(interpretation_type), location_address = VALUES(location_address), access_link = VALUES(access_link), start_time = VALUES(start_time), end_time = VALUES(end_time), timezone = VALUES(timezone), hourly_rate = VALUES(hourly_rate), daily_rate = VALUES(daily_rate), extra_costs = VALUES(extra_costs), extra_costs_description = VALUES(extra_costs_description), equipment_units = VALUES(equipment_units), equipment_rate = VALUES(equipment_rate)
                        ");
                        $stmt_interp->execute([$project_id_edit, $user_id, $interpretation_type, $location_address, $access_link, $start_time, $end_time, $timezone, $hourly_rate, $daily_rate, $extra_costs, $extra_costs_description, $equipment_units, $equipment_rate]);
                    } else {
                        $stmt_interp_del = $pdo->prepare("DELETE FROM dash_interpretation_details WHERE project_id = ? AND user_id = ?");
                        $stmt_interp_del->execute([$project_id_edit, $user_id]);
                    }
                    // --- FIM: Lógica de Interpretação (EDIT) ---

                    // [NOVO] INÍCIO: Lógica de Custo (Job) (EDIT)
                    if ($freelancer_id && $freelancer_rate > 0) {
                        $total_cost = $quantity * $freelancer_rate;
                        
                        $stmt_check_job = $pdo->prepare("SELECT id FROM dash_jobs WHERE project_id = ? AND freelancer_id = ? AND user_id = ?");
                        $stmt_check_job->execute([$project_id_edit, $freelancer_id, $user_id]);
                        $existing_job_id = $stmt_check_job->fetchColumn();

                        if ($existing_job_id) {
                            $stmt_job = $pdo->prepare(
                                "UPDATE dash_jobs SET service_type = ?, unit_type = ?, quantity = ?, rate = ?, currency = ?, total_cost = ?, deadline = ?
                                 WHERE id = ? AND user_id = ?"
                            );
                            $stmt_job->execute([
                                $_POST['service_type'], $unit_type, $quantity, $freelancer_rate, $freelancer_currency, $total_cost, $project_deadline,
                                $existing_job_id, $user_id
                            ]);
                        } else {
                            $stmt_job = $pdo->prepare(
                                "INSERT INTO dash_jobs (user_id, project_id, freelancer_id, service_type, unit_type, quantity, rate, currency, total_cost, deadline, status) 
                                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
                            );
                            $stmt_job->execute([
                                $user_id, $project_id_edit, $freelancer_id, $_POST['service_type'], $unit_type, $quantity, $freelancer_rate, $freelancer_currency, $total_cost, $project_deadline, 'pending'
                            ]);
                        }
                    }
                    // [NOVO] FIM: Lógica de Custo (Job) (EDIT)

                    $pdo->commit(); // Confirma transação
                    if ($result) { 
                        $_SESSION['temp_message'] = 'Projeto atualizado com sucesso!';
                        header("Location: projects_list.php?edit=" . $project_id_edit); // Redireciona para a lista
                        exit;
                    } else { 
                        $error = 'Erro ao atualizar projeto.'; 
                    }

                } catch (PDOException $e) { 
                    $pdo->rollBack(); // Desfaz em caso de erro
                    $error = 'Erro: ' . $e->getMessage(); 
                }
                break;

            // CASOS 'delete_project', 'complete_project', 'generate_invoice' MOVIDOS PARA projects_list.php
        }
    }
}

if(isset($_SESSION['temp_message'])) {
    $message = $_SESSION['temp_message'];
    unset($_SESSION['temp_message']);
}
if(isset($_SESSION['temp_error'])) {
    $error = $_SESSION['temp_error'];
    unset($_SESSION['temp_error']);
}


// --- INÍCIO: LÓGICA DE PREENCHIMENTO DO FORMULÁRIO ---

// Obter lista de clientes (para o dropdown)
$stmt = $pdo->prepare("SELECT id, company AS company_name, default_currency FROM dash_clients WHERE user_id = ? ORDER BY company ASC");
$stmt->execute([$user_id]);
$clients = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Consulta para obter a lista de freelancers (ativos) (para o dropdown)
$stmt = $pdo->prepare("SELECT id, name FROM dash_freelancers WHERE user_id = ? AND is_active = 1 ORDER BY name ASC");
$stmt->execute([$user_id]);
$freelancers_list = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Obter a estrutura de preços dos freelancers para o JavaScript
$stmt = $pdo->prepare("SELECT id, pricing_structure, currency FROM dash_freelancers WHERE user_id = ? AND is_active = 1");
$stmt->execute([$user_id]);
$freelancers_pricing_data = $stmt->fetchAll(PDO::FETCH_ASSOC);

$freelancers_pricing_json = [];
foreach ($freelancers_pricing_data as $data) {
    $freelancers_pricing_json[$data['id']] = [
        'pricing' => json_decode($data['pricing_structure'] ?? '[]', true),
        'currency' => $data['currency']
    ];
}

// Obter projeto para edição se solicitado
$edit_project = null;
$is_editing = false;
if (isset($_GET['edit']) && is_numeric($_GET['edit'])) {
    
    // Query de Edição MODIFICADA
    $stmt = $pdo->prepare("
        SELECT 
            p.*, 
            p.title AS project_name, 
            p.description AS project_description, 
            p.po_number, 
            p.daily_word_target, 
            c.company AS company_name,
            c.name AS contact_name, 
            p.unit_type, 
            p.lauda_size, 
            p.lauda_unit, 
            p.payment_date,
            d.interpretation_type, 
            d.location_address, 
            d.access_link,
            d.start_time, 
            d.end_time, 
            d.timezone, 
            d.hourly_rate,
            d.daily_rate, 
            d.extra_costs, 
            d.extra_costs_description,
            d.equipment_units, 
            d.equipment_rate
        FROM dash_projects p 
        LEFT JOIN dash_clients c ON p.client_id = c.id 
        LEFT JOIN dash_interpretation_details d ON p.id = d.project_id
        WHERE p.id = ? AND p.user_id = ?
    ");
    $stmt->execute([$_GET['edit'], $user_id]);
    $edit_project = $stmt->fetch(PDO::FETCH_ASSOC);
    
    if ($edit_project) {
        $is_editing = true;
        
        // [NOVO] Buscar o primeiro/principal job associado para preencher os campos de custo
        $stmt_job = $pdo->prepare("SELECT freelancer_id, rate, currency FROM dash_jobs WHERE project_id = ? AND user_id = ? ORDER BY id ASC LIMIT 1");
        $stmt_job->execute([$_GET['edit'], $user_id]);
        $main_job = $stmt_job->fetch(PDO::FETCH_ASSOC);
        
        if ($main_job) {
            // Mescla os dados do job no array do projeto para preencher o formulário
            $edit_project['freelancer_id'] = $main_job['freelancer_id'];
            $edit_project['rate_per_word_freelancer'] = $main_job['rate'];
            $edit_project['currency_freelancer'] = $main_job['currency'];
        }
    }
}
// --- FIM: LÓGICA DE PREENCHIMENTO DO FORMULÁRIO ---


$page_title = "Projetos - Dash-T101";
$page_description = "Gerencie seus projetos de tradução e acompanhe o progresso.";
include __DIR__ . '/../vision/includes/head.php';
include __DIR__ . '/../vision/includes/header.php';
include __DIR__ . '/../vision/includes/sidebar.php';
?>

<div class="main-content">
    <?php if ($message): ?><div id="success-alert" class="alert-success"><i class="fas fa-check-circle"></i><?php echo htmlspecialchars($message); ?></div><?php endif; ?>
    <?php if ($error): ?><div class="alert-error"><i class="fas fa-exclamation-triangle"></i><?php echo htmlspecialchars($error); ?></div><?php endif; ?>

    <div class="video-card profile-header-card" style="background: linear-gradient(135deg, var(--brand-purple), #4a148c); border: none; margin-bottom: 25px;">
        <div class="header-icon-container" style="background: rgba(255, 255, 255, 0.1); border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <i class="fas fa-folder-open" style="font-size: 1.8rem; color: #fff;"></i>
        </div>
        <div class="header-text-container" style="margin-left: 20px;">
            <h2 style="margin: 0 0 5px 0; padding: 0; font-size: 1.5rem; color: #fff; font-weight: 600; border: none;"><?php echo $is_editing ? 'Editar Projeto' : 'Adicionar Projeto'; ?></h2>
            <p style="margin: 0; color: rgba(255, 255, 255, 0.8); font-size: 1rem;">Preencha os detalhes abaixo para <?php echo $is_editing ? 'atualizar' : 'criar'; ?> o projeto.</p>
        </div>
    </div>
    
    <div class="report-nav-buttons">
        <a href="index.php" class="vision-btn vision-btn-secondary"><i class="fas fa-home"></i> Voltar ao Dash-T101</a>
        <a href="projects_list.php" class="vision-btn vision-btn-primary"><i class="fas fa-list"></i> Ver Lista de Projetos</a>
    </div>

    <div class="video-card">
        <h2><i class="fas fa-plus-circle"></i> <?php echo $is_editing ? 'Detalhes do Projeto' : 'Adicionar novo projeto'; ?></h2>
        
        <form method="POST" class="vision-form-refined" action="projects.php"> <input type="hidden" name="action" value="<?php echo $edit_project ? 'edit_project' : 'add_project'; ?>">
            <?php if ($edit_project): ?><input type="hidden" name="project_id" value="<?php echo $edit_project['id']; ?>"><?php endif; ?>
            <div class="form-row">
                <div class="form-group form-group-full">
                    <label for="project_name"><i class="fas fa-folder-plus"></i> Nome do projeto *</label>
                    <input type="text" id="project_name" name="project_name" required value="<?php echo htmlspecialchars($edit_project['project_name'] ?? ''); ?>" class="vision-input">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="client_id"><i class="fas fa-user"></i> Cliente *</label>
                    <div class="client-container">
                        <select id="client_id" name="client_id" required class="vision-select">
                            <option value="">Selecione um cliente</option>
                            <?php
                            $last_added_client_id = $_SESSION['last_added_client_id'] ?? null;
                            if ($last_added_client_id) {
                                unset($_SESSION['last_added_client_id']);
                            }
                            foreach ($clients as $client): 
                                $isSelected = ($edit_project && $edit_project['client_id'] == $client['id']) || ($last_added_client_id == $client['id']);
                            ?>
                                <option value="<?php echo $client['id']; ?>" data-currency="<?php echo htmlspecialchars($client['default_currency']); ?>" <?php echo $isSelected ? 'selected' : ''; ?>>
                                    <?php echo htmlspecialchars($client['company_name']); ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                        <button type="button" class="add-service-btn" onclick="showAddClientModal()"><i class="fas fa-plus"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="source_lang"><i class="fas fa-language"></i> Idioma de origem *</label>
                    <select id="source_lang" name="source_lang" required class="vision-select">
                        <option value="">Selecione</option>
                        <?php foreach ($languages as $code => $name): ?>
                            <option value="<?php echo $code; ?>" <?php echo ($edit_project && $edit_project['source_language'] == $code) ? 'selected' : ''; ?>><?php echo $name; ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="form-group">
                    <label for="target_lang"><i class="fas fa-language"></i> Idioma de destino *</label>
                    <select id="target_lang" name="target_lang" required class="vision-select">
                        <option value="">Selecione</option>
                        <?php foreach ($languages as $code => $name): ?>
                            <option value="<?php echo $code; ?>" <?php echo ($edit_project && $edit_project['target_language'] == $code) ? 'selected' : ''; ?>><?php echo $name; ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="service_type"><i class="fas fa-cogs"></i> Tipo de serviço *</label>
                    <div class="service-type-container">
                        <select id="service_type" name="service_type" required class="vision-select">
                            <?php foreach ($service_types_list as $code => $name): ?>
                                <option value="<?php echo $code; ?>" <?php echo ($edit_project && $edit_project['service_type'] == $code) ? 'selected' : ''; ?>><?php echo $name; ?></option>
                            <?php endforeach; ?>
                            <?php if (isset($_SESSION['custom_services'])): foreach ($_SESSION['custom_services'] as $service): ?>
                                <option value="<?php echo htmlspecialchars($service); ?>" <?php if ($edit_project && $edit_project['service_type'] == $service) { echo 'selected'; } elseif ($new_service_added && $new_service_added == $service) { echo 'selected'; } ?>>
                                    <?php echo htmlspecialchars($service); ?>
                                </option>
                            <?php endforeach; endif; ?>
                        </select>
                        <button type="button" class="add-service-btn" onclick="showAddServiceModal()"><i class="fas fa-plus"></i></button>
                    </div>
                </div>
                
                <div class="form-group">
