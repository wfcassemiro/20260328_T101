<script>
/**
 * Time Tracker - Lógica Integrada V3
 */

// 1. Configuração Automática da API
let currentPath = window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/'));
if (currentPath === '/') currentPath = '';
const API_URL = window.location.origin + currentPath + '/api_time_tracker.php';
console.log('[TT] API Definida:', API_URL);

// 2. Estado Global
const state = {
    runningEntry: null,
    timerInterval: null,
    isPaused: false,
    projects: [],
    localStartTime: null,
    serverDurationAtStart: 0
};

// 3. Inicialização
document.addEventListener('DOMContentLoaded', () => {
    loadProjects();
    loadEntries();
    checkRunningTimer();
    setupEventListeners();
    
    // Loop visual de 1s
    if (state.timerInterval) clearInterval(state.timerInterval);
    state.timerInterval = setInterval(updateTimerTick, 1000);
});

// ==== LÓGICA DO CRONÔMETRO ====
function updateTimerTick() {
    if (!state.runningEntry || state.isPaused) return;

    const now = Date.now();
    const secondsPassedLocally = Math.floor((now - state.localStartTime) / 1000);
    const totalSeconds = state.serverDurationAtStart + secondsPassedLocally;

    const formatted = formatDuration(totalSeconds);
    const display = document.querySelector('.time-digits');
    if(display) {
        display.textContent = formatted;
        display.style.opacity = '1';
        // Cor dinâmica enquanto roda
        display.style.textShadow = '0 0 20px rgba(124, 77, 255, 0.4)';
    }
    document.title = `${formatted} - Time Tracker`;
}

function applyRunningState(entry) {
    state.runningEntry = entry;
    state.isPaused = entry.is_paused || false;
    
    // Sincronização
    state.localStartTime = Date.now();
    state.serverDurationAtStart = parseInt(entry.duration) || 0;
    
    updateTimerUI();
    const display = document.querySelector('.time-digits');
    if(display) display.textContent = formatDuration(state.serverDurationAtStart);
}

// ==== API FETCH WRAPPER ====
async function apiCall(action, data = null) {
    let body;
    let url = API_URL + '?action=' + action;
    
    if (data) {
        const fd = new FormData();
        fd.append('action', action);
        for (const key in data) fd.append(key, data[key]);
        body = fd;
        url = API_URL; 
    }

    try {
        const response = await fetch(url, { method: data ? 'POST' : 'GET', body: body });
        const json = await response.json();
        return json;
    } catch (error) {
        console.error('[TT Error]', error);
        showNotification('Erro de conexão com API', 'error');
        return { success: false };
    }
}

// ==== AÇÕES ====
async function startTimer() {
    const desc = document.getElementById('timerDescription').value;
    const pid = document.getElementById('timerProject').value;
    const tid = document.getElementById('timerTask').value;

    showLoading(true);
    const res = await apiCall('entry_start', { description: desc, project_id: pid, task_id: tid });
    showLoading(false);

    if (res.success) {
        if (res.entry) {
            applyRunningState(res.entry);
            showNotification('Cronômetro Iniciado!', 'success');
        } else {
            checkRunningTimer();
        }
    } else {
        showNotification(res.error || 'Erro ao iniciar', 'error');
    }
}

async function pauseTimer() {
    if (!state.runningEntry) return;
    const res = await apiCall('entry_pause', { id: state.runningEntry.id });
    if (res.success) { state.isPaused = true; updateTimerUI(); }
}

async function resumeTimer() {
    if (!state.runningEntry) return;
    const res = await apiCall('entry_resume', { id: state.runningEntry.id });
    if (res.success) { checkRunningTimer(); }
}

async function stopTimer() {
    if (!state.runningEntry) return;
    if (!confirm('Parar cronômetro?')) return;
    
    const res = await apiCall('entry_stop', { id: state.runningEntry.id });
    if (res.success) {
        state.runningEntry = null;
        resetTimerUI();
        loadEntries();
        document.title = 'Time Tracker';
        showNotification('Finalizado: ' + res.duration_formatted, 'success');
    }
}

async function checkRunningTimer() {
    const res = await apiCall('entry_running');
    if (res.success && res.entry) {
        applyRunningState(res.entry);
    } else {
        state.runningEntry = null;
        resetTimerUI();
    }
}

async function loadProjects() {
    const res = await apiCall('project_list');
    if (res.success) {
        state.projects = res.projects;
        const s = document.getElementById('timerProject');
        const f = document.getElementById('filterProject');
        const current = s.value;
        
        const opts = '<option value="">Selecione um projeto</option>' + 
            res.projects.map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
        
        s.innerHTML = opts;
        f.innerHTML = '<option value="">Todos os Projetos</option>' + 
            res.projects.map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join('');
            
        if (current) s.value = current;
    }
}

async function loadEntries() {
    const pid = document.getElementById('filterProject').value;
    const url = pid ? `entry_list&project_id=${pid}&limit=50` : 'entry_list&limit=50';
    
    try {
        const r = await fetch(API_URL + '?action=' + url);
        const d = await r.json();
        if (d.success) renderEntries(d.entries);
    } catch(e) { console.error(e); }
}

async function createQuickProject(e) {
    e.preventDefault();
    const name = document.getElementById('quickProjectName').value;
    const res = await apiCall('project_create_quick', { name: name });
    
    if (res.success) {
        closeQuickProjectModal();
        await loadProjects();
        showNotification('Projeto Criado!', 'success');
        setTimeout(() => {
            const s = document.getElementById('timerProject');
            if (s) s.value = res.project_id;
        }, 500);
    } else {
        showNotification(res.error, 'error');
    }
}

async function deleteEntry(id) {
    if(!confirm('Apagar registro?')) return;
    const res = await apiCall('entry_delete', { id: id });
    if(res.success) loadEntries();
}

async function loadTasks(pid) {
    const res = await fetch(API_URL + '?action=task_list&project_id=' + pid).then(r=>r.json());
    if(res.success) {
        const s = document.getElementById('timerTask');
        s.innerHTML = '<option value="">Selecione Tarefa</option>' + res.tasks.map(t=>`<option value="${t.id}">${escapeHtml(t.name)}</option>`).join('');
    }
}

// ==== UI UTILS ====
function updateTimerUI() {
    if (state.runningEntry) {
        document.getElementById('startButton').style.display = 'none';
        document.getElementById('stopButton').style.display = 'inline-flex';
        document.getElementById('timerDescription').value = state.runningEntry.description || '';
        
        const ps = document.getElementById('timerProject');
        if (ps && state.runningEntry.project_id) { ps.value = state.runningEntry.project_id; ps.disabled = true; }
        
        const ts = document.getElementById('timerTask');
        if (ts) ts.disabled = true;

        let info = '';
        if (state.runningEntry.project_name) info += `<span style="color:#7c4dff">● ${escapeHtml(state.runningEntry.project_name)}</span>`;
        document.getElementById('timerInfo').innerHTML = info;

        if (state.isPaused) {
            document.getElementById('pauseButton').style.display = 'none';
            document.getElementById('resumeButton').style.display = 'inline-flex';
            document.querySelector('.time-digits').style.opacity = '0.5';
            document.querySelector('.time-digits').style.textShadow = 'none';
        } else {
            document.getElementById('pauseButton').style.display = 'inline-flex';
            document.getElementById('resumeButton').style.display = 'none';
            document.querySelector('.time-digits').style.opacity = '1';
        }
    } else {
        resetTimerUI();
    }
}

function resetTimerUI() {
    const d = document.querySelector('.time-digits');
    if(d) { d.textContent = '00:00:00'; d.style.opacity = '1'; d.style.textShadow = 'none'; }
    document.getElementById('timerInfo').innerHTML = '';
    document.getElementById('timerDescription').value = '';
    document.getElementById('timerProject').disabled = false;
    document.getElementById('timerTask').disabled = true;
    document.getElementById('startButton').style.display = 'inline-flex';
    document.getElementById('pauseButton').style.display = 'none';
    document.getElementById('resumeButton').style.display = 'none';
    document.getElementById('stopButton').style.display = 'none';
}

function renderEntries(entries) {
    const c = document.getElementById('entriesList');
    if (!entries || entries.length === 0) {
        c.innerHTML = '<div style="padding:30px;text-align:center;color:#999">Nenhum registro encontrado.</div>';
        return;
    }
    
    c.innerHTML = entries.map(e => `
        <div class="entry-item">
            <div class="entry-color" style="background:${e.project_color || '#7c4dff'}"></div>
            <div class="entry-details">
                <div class="entry-description">${escapeHtml(e.description || 'Sem descrição')}</div>
                <div class="entry-meta">
                    ${e.project_name ? `<span><i class="fas fa-folder"></i> ${escapeHtml(e.project_name)}</span>` : ''}
                    <span><i class="fas fa-clock"></i> ${new Date(e.start_time.replace(' ','T')).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</span>
                </div>
            </div>
            <div class="entry-duration">${e.duration_formatted}</div>
            <button class="btn-icon-small" onclick="deleteEntry('${e.id}')" style="width:36px;height:36px;margin-left:10px;color:#ff3b30;border-color:rgba(255,59,48,0.3);background:rgba(255,59,48,0.1)"><i class="fas fa-trash"></i></button>
        </div>
    `).join('');
}

// Helpers
function formatDuration(s) { const h=Math.floor(s/3600), m=Math.floor((s%3600)/60), sec=s%60; return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0'); }
function escapeHtml(t) { return t ? t.replace(/&/g,'&amp;').replace(/</g,'&lt;') : ''; }
function showLoading(show) { 
    const b = document.getElementById('startButton'); 
    if(b) { 
        b.disabled = show; 
        b.innerHTML = show ? '<i class="fas fa-spinner fa-spin"></i>' : '<i class="fas fa-play"></i> INICIAR TIMER'; 
    } 
}
function showNotification(msg, type) { const d = document.createElement('div'); d.className = `toast-notification toast-${type} show`; d.innerHTML = msg; document.body.appendChild(d); setTimeout(()=>d.remove(), 3000); }
function openQuickProjectModal() { document.getElementById('quickProjectModal').classList.add('active'); }
function closeQuickProjectModal() { document.getElementById('quickProjectModal').classList.remove('active'); }

// Eventos
function setupEventListeners() {
    document.getElementById('startButton')?.addEventListener('click', startTimer);
    document.getElementById('pauseButton')?.addEventListener('click', pauseTimer);
    document.getElementById('resumeButton')?.addEventListener('click', resumeTimer);
    document.getElementById('stopButton')?.addEventListener('click', stopTimer);
    document.getElementById('quickProjectForm')?.addEventListener('submit', createQuickProject);
    document.getElementById('timerProject')?.addEventListener('change', function() {
        const pid = this.value;
        const ts = document.getElementById('timerTask');
        ts.disabled = !pid;
        if(pid) loadTasks(pid);
    });
}
</script>