                            <th><i class="fas fa-dollar-sign"></i> Receita</th>
                            <th style="width: 200px;"><i class="fas fa-cogs"></i> Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php 
                        foreach ($projects as $project): 
                            $status_label = $status_labels[$project['status']] ?? 'Indefinido';
                            $status_color = $status_colors[$project['status']] ?? '#777';
                            
                            // --- [NOVO] Bloco de Cálculo de Custos/Lucro ---
                            
                            // 1. Calcular Custo Total BRL
                            $stmt_jobs = $pdo->prepare("SELECT total_cost, currency FROM dash_jobs WHERE project_id = ? AND user_id = ?");
                            $stmt_jobs->execute([$project['id'], $user_id]);
                            $jobs = $stmt_jobs->fetchAll(PDO::FETCH_ASSOC);

                            $total_cost_brl = 0;
                            $conversion_failed = false;
                            foreach ($jobs as $job) {
                                $converted_cost = $convert_to_brl($job['total_cost'], $job['currency']);
                                if ($converted_cost === null) {
                                    $conversion_failed = true;
                                }
                                $total_cost_brl += $converted_cost ?? 0;
                            }

                            // 2. Calcular Receita Total BRL
                            $total_revenue_brl = $convert_to_brl($project['total_amount'], $project['currency']);
                            if ($total_revenue_brl === null) {
                                $total_revenue_brl = 0;
                                $conversion_failed = true;
                            }
                            
                            // 3. Calcular Imposto Total BRL
                            $tax_percentage = (float)($project['tax_percentage'] ?? 0);
                            $total_tax_brl = $total_revenue_brl * ($tax_percentage / 100);

                            // 4. Calcular Lucro Líquido BRL
                            $total_profit_brl = $total_revenue_brl - $total_cost_brl - $total_tax_brl;
                            
                            // --- [FIM NOVO] ---

                            // [ALTERADO] Passa os valores BRL para o JSON
                            $project_data_json = htmlspecialchars(json_encode([
                                'id' => $project['id'],
                                'title' => $project['title'],
                                'client_name' => $project['company_name'] ?? 'N/A',
                                'status' => $project['status'],
                                'status_label' => $status_label,
                                'status_color' => $status_color,
                                'start_date' => $project['start_date'] ? date('d/m/Y', strtotime($project['start_date'])) : 'N/A',
                                'deadline' => $project['deadline'] ? date('d/m/Y', strtotime($project['deadline'])) : 'N/A',
                                'completed_date' => $project['completed_date'] ? date('d/m/Y', strtotime($project['completed_date'])) : 'N/A',
                                'total_amount' => $project['total_amount'],
                                'currency' => $project['currency'],
                                'tax_percentage' => $project['tax_percentage'] ?? 0.00,
                                'conversion_failed' => $conversion_failed, // Passa o status de falha
                                
                                // [NOVOS CAMPOS]
                                'total_revenue_brl' => $total_revenue_brl,
                                'total_cost_brl' => $total_cost_brl,
                                'total_tax_brl' => $total_tax_brl,
                                'total_profit_brl' => $total_profit_brl
                                
                            ]), ENT_QUOTES, 'UTF-8');
                        ?>
