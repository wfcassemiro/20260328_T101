            <div class="pagination-container">
                <?php
                // Constrói a query string para os filtros
                $query_params = [];
                if ($filter_status !== 'all') $query_params['status'] = $filter_status;
                if ($filter_client !== 'all') $query_params['client_id'] = $filter_client;
                if (!empty($filter_search)) $query_params['search'] = $filter_search;
                $query_string = http_build_query($query_params);
                
                // Botão Anterior
                if ($page > 1) {
                    echo "<a href='?page=".($page - 1)."&{$query_string}' class='page-btn'>&laquo; Anterior</a>";
                }

                // Números das Páginas
                for ($i = 1; $i <= $total_pages; $i++) {
                    $activeClass = ($i == $page) ? 'active' : '';
                    echo "<a href='?page={$i}&{$query_string}' class='page-btn {$activeClass}'>{$i}</a>";
                }

                // Botão Próximo
                if ($page < $total_pages) {
                    echo "<a href='?page=".($page + 1)."&{$query_string}' class='page-btn'>Próximo &raquo;</a>";
                }
                ?>
            </div>
        <?php endif; ?>

    </div>
</div>

