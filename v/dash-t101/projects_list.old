require_once __DIR__ . '/../config/dash_database.php';
require_once __DIR__ . '/../config/dash_functions.php';

// Verificar se o usuário está logado
if (!isLoggedIn()) {
    header('Location: /login.php?redirect=' . urlencode($_SERVER['REQUEST_URI']));
    exit;
}

$page_title = 'Lista de Projetos - Dash-T101';
$user_id = $_SESSION['user_id'];
$message = '';
$error = '';

// Processar ações da lista (delete, complete, invoice)
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['action'])) {
        switch ($_POST['action']) {
            case 'delete_project':
                try {
                    $pdo->beginTransaction();
                    
                    $project_id = $_POST['project_id'];
                    
                    // Excluir dependências primeiro (jobs, interpretation)
                    $stmt_del_jobs = $pdo->prepare("DELETE FROM dash_jobs WHERE project_id = ? AND user_id = ?");
                    $stmt_del_jobs->execute([$project_id, $user_id]);
                    
                    $stmt_del_interp = $pdo->prepare("DELETE FROM dash_interpretation_details WHERE project_id = ? AND user_id = ?");
                    $stmt_del_interp->execute([$project_id, $user_id]);
                    
                    // Excluir projeto principal
                    $stmt = $pdo->prepare("DELETE FROM dash_projects WHERE id = ? AND user_id = ?");
                    $stmt->execute([$project_id, $user_id]);
                    
                    $pdo->commit();
                    $_SESSION['temp_message'] = 'Projeto excluído com sucesso!';
                } catch (PDOException $e) {
                    $pdo->rollBack();
                    $_SESSION['temp_error'] = 'Erro ao excluir projeto: ' . $e->getMessage();
                }
                header("Location: projects_list.php");
                exit;
                break;

            case 'complete_project':
                try {
                    $project_id = $_POST['project_id'];
                    // [ALTERADO] Define a data de conclusão E o status
                    $stmt = $pdo->prepare("UPDATE dash_projects SET status = 'completed', completed_date = ? WHERE id = ? AND user_id = ?");
                    $stmt->execute([date('Y-m-d'), $project_id, $user_id]);
                    $_SESSION['temp_message'] = 'Projeto marcado como concluído!';
                } catch (PDOException $e) {
                    $_SESSION['temp_error'] = 'Erro ao concluir projeto: ' . $e->getMessage();
                }
                header("Location: projects_list.php");
                exit;
                break;
            
            case 'invoice_project':
                // (Lógica para gerar fatura...)
                $_SESSION['temp_message'] = 'Fatura gerada (função pendente).';
                header("Location: projects_list.php");
                exit;
                break;
        }
    }
}

if (isset($_SESSION['temp_message'])) {
    $message = $_SESSION['temp_message'];
    unset($_SESSION['temp_message']);
}
if (isset($_SESSION['temp_error'])) {
    $error = $_SESSION['temp_error'];
    unset($_SESSION['temp_error']);
}

// [NOVO] Buscar taxas de câmbio para conversão (igual ao report_profit_loss)
$rates = ['BRL' => 1.0]; // Moeda base
try {
    $stmt_rates = $pdo->prepare("SELECT setting_key, setting_value FROM dash_settings WHERE user_id = ? AND setting_key LIKE 'rate_%'");
    $stmt_rates->execute([$user_id]);
    foreach ($stmt_rates->fetchAll(PDO::FETCH_ASSOC) as $row) {
        $code = strtoupper(str_replace('rate_', '', $row['setting_key']));
        if((float)$row['setting_value'] > 0) {
            // Armazena a taxa de conversão PARA BRL (Ex: 1 USD = 5.2 BRL)
            $rates[$code] = (float)$row['setting_value'];
        }
    }
} catch (Exception $e) {
    // Falha ao buscar taxas, continuar apenas com BRL
    $error = "Aviso: Falha ao buscar taxas de câmbio. Os cálculos podem estar incompletos.";
}

// [NOVO] Função helper para converter moedas para BRL (igual ao report_profit_loss)
$convert_to_brl = function($amount, $currency) use ($rates) {
    if ($currency === 'BRL') {
        return $amount;
    }
    if (!isset($rates[$currency]) || $rates[$currency] == 0) {
        return null; // Taxa não encontrada
    }
    $rate = $rates[$currency];
    return $amount * $rate;
};


// --- Lógica de Busca e Paginação ---

// Definições de Status (para cores e labels)
$status_labels = [
    'pending' => 'Pendente',
    'in_progress' => 'Em andamento',
    'completed' => 'Concluído'
];
$status_colors = [
    'pending' => '#e67e22', // Laranja
    'in_progress' => '#3498db', // Azul
    'completed' => '#2ecc71' // Verde
];

// Filtros
$filter_status = $_GET['status'] ?? 'all';
$filter_client = $_GET['client_id'] ?? 'all';
$filter_search = $_GET['search'] ?? '';

// Construção da Query
$params = [$user_id];
$where_clauses = [];

if ($filter_status !== 'all') {
    $where_clauses[] = "p.status = ?";
    $params[] = $filter_status;
}
if ($filter_client !== 'all') {
    $where_clauses[] = "p.client_id = ?";
    $params[] = $filter_client;
}
if (!empty($filter_search)) {
    $where_clauses[] = "(p.title LIKE ? OR p.po_number LIKE ? OR c.company LIKE ?)";
    $params[] = "%$filter_search%";
    $params[] = "%$filter_search%";
    $params[] = "%$filter_search%";
}

$where_sql = count($where_clauses) > 0 ? "AND " . implode(" AND ", $where_clauses) : "";

// Contagem total para paginação
$stmt_count = $pdo->prepare("
    SELECT COUNT(p.id) 
    FROM dash_projects p
    LEFT JOIN dash_clients c ON p.client_id = c.id
    WHERE p.user_id = ? $where_sql
");
$stmt_count->execute($params);
$total_projects = $stmt_count->fetchColumn();

// Paginação
$page = isset($_GET['page']) && is_numeric($_GET['page']) ? (int)$_GET['page'] : 1;
$limit = 10;
$offset = ($page - 1) * $limit;
$total_pages = ceil($total_projects / $limit);

// Busca dos projetos (Query principal)
// [ALTERADO] Adicionado p.tax_percentage
$stmt = $pdo->prepare("
    SELECT 
        p.id, p.title, p.po_number, p.total_amount, p.currency, p.status, 
        p.start_date, p.deadline, p.completed_date, p.tax_percentage,
        c.company AS company_name
    FROM dash_projects p
    LEFT JOIN dash_clients c ON p.client_id = c.id
    WHERE p.user_id = ? $where_sql
    ORDER BY p.created_at DESC
    LIMIT $limit OFFSET $offset
");
$stmt->execute($params);
$projects = $stmt->fetchAll(PDO::FETCH_ASSOC);

// Obter lista de clientes (para o filtro)
$stmt_clients = $pdo->prepare("SELECT id, company FROM dash_clients WHERE user_id = ? ORDER BY company ASC");
$stmt_clients->execute([$user_id]);
$clients_list = $stmt_clients->fetchAll(PDO::FETCH_ASSOC);


// --- Lógica da Timeline (Visão Geral) ---
// Define o centro da timeline (HOJE)
$timeline_center_date = new DateTime(); 
$timeline_start_date = (clone $timeline_center_date)->modify('-30 days');
$timeline_end_date = (clone $timeline_center_date)->modify('+30 days');

// [CORREÇÃO] Armazena as datas formatadas em variáveis
$start_date_str = $timeline_start_date->format('Y-m-d');
$end_date_str = $timeline_end_date->format('Y-m-d');

// Busca projetos ativos (pendentes ou em andamento) para a timeline
// [CORREÇÃO] Usa placeholders NOMEADOS e ÚNICOS
$stmt_timeline = $pdo->prepare("
    SELECT id, title, start_date, deadline, status 
    FROM dash_projects 
    WHERE user_id = :user_id 
    AND status IN ('pending', 'in_progress')
    AND (
        (start_date <= :end_date_1 AND deadline >= :start_date_1) OR
        (start_date IS NULL AND deadline >= :start_date_2 AND deadline <= :end_date_2)
    )
    ORDER BY deadline ASC, start_date ASC
");
// [CORREÇÃO] Passa todos os placeholders únicos, mesmo que os valores sejam repetidos
$stmt_timeline->execute([
    'user_id' => $user_id,
    'start_date_1' => $start_date_str,
    'end_date_1' => $end_date_str,
    'start_date_2' => $start_date_str,
    'end_date_2' => $end_date_str
]);
$timeline_projects = $stmt_timeline->fetchAll(PDO::FETCH_ASSOC);

// Função para calcular a posição na timeline (em %)
function get_timeline_position($date_str, $start_date, $end_date) {
    if (empty($date_str)) return null;
    $date = new DateTime($date_str);
    $total_days = $start_date->diff($end_date)->days;
    if ($total_days == 0) return 0;
    
    $days_from_start = $start_date->diff($date)->days;
    $position = ($days_from_start / $total_days) * 100;
    
    return max(0, min(100, $position));
}

// Calcular posições para os projetos da timeline
$timeline_data = [];
$total_timeline_days = $timeline_start_date->diff($timeline_end_date)->days;

foreach ($timeline_projects as $project) {
    // Se não tiver data de início, usa a data de hoje ou deadline-7
    $start_str = $project['start_date'];
    if (empty($start_str)) {
        if (!empty($project['deadline'])) {
            $start_str = (new DateTime($project['deadline']))->modify('-7 days')->format('Y-m-d');
        } else {
            $start_str = (new DateTime())->format('Y-m-d');
        }
    }
    
    // Se não tiver deadline, usa a data de hoje ou start+7
    $end_str = $project['deadline'];
    if (empty($end_str)) {
        if (!empty($project['start_date'])) {
            $end_str = (new DateTime($project['start_date']))->modify('+7 days')->format('Y-m-d');
        } else {
            $end_str = (new DateTime())->modify('+7 days')->format('Y-m-d');
        }
    }

    $start_pos = get_timeline_position($start_str, $timeline_start_date, $timeline_end_date);
    $end_pos = get_timeline_position($end_str, $timeline_start_date, $timeline_end_date);
    
    // Garante que a barra tenha uma largura mínima se as datas forem iguais
    if ($end_pos == $start_pos) {
        $end_pos = $start_pos + 1.5; // ~1 dia em 60 dias
    }
    
    $width = max(0, $end_pos - $start_pos);

    $timeline_data[] = [
        'id' => $project['id'],
        'title' => $project['title'],
        'start_pos' => $start_pos,
        'width' => $width,
        'status_color' => $status_colors[$project['status']] ?? '#777'
    ];
}

// Posição do marcador 'HOJE'
$today_pos = get_timeline_position($timeline_center_date->format('Y-m-d'), $timeline_start_date, $timeline_end_date);

// Marcadores verticais (Semanas)
$v_markers = [];
$current_marker_date = (clone $timeline_start_date);
while ($current_marker_date <= $timeline_end_date) {
    $pos = get_timeline_position($current_marker_date->format('Y-m-d'), $timeline_start_date, $timeline_end_date);
    $v_markers[] = [
        'pos' => $pos,
        'label' => $current_marker_date->format('d/m')
    ];
    $current_marker_date->modify('+1 week');
}


$page_description = "Gerencie, filtre e visualize todos os seus projetos.";
