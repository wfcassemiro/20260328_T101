}
/* FIM: NOVOS ESTILOS DAS MARCAS VERTICAIS */

</style>

<script>
    (function() {
        "use strict";
        
        // --- Lógica do Alerta de Sucesso ---
        const successAlert = document.getElementById('success-alert');
        if (successAlert) {
            setTimeout(() => {
                successAlert.style.opacity = '0';
                setTimeout(() => { successAlert.remove(); }, 1000); 
            }, 5000);
        }

        // --- Lógica de Formatação de Moeda ---
        // (Usada pelo modal)
        function formatCurrencyJS(value, currency) {
            if (value === null || value === undefined) return 'N/A';
            try {
                return new Intl.NumberFormat('pt-BR', {
                    style: 'currency',
                    currency: currency,
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(value);
            } catch (e) {
                // Fallback para moedas não-padrão (ou se a taxa falhar)
                if (currency) {
                    return `${currency} ${parseFloat(value).toFixed(2)}`;
                }
                return `BRL ${parseFloat(value).toFixed(2)}`;
            }
        }

        // --- Lógica do Modal de Detalhes ---
        const modal = document.getElementById("projectDetailsModal");
        const modalWarning = document.getElementById("modal_conversion_warning");

        // [ALTERADO] Função do Modal para usar os dados BRL
        window.openProjectDetailsModal = function(projectData) {
            if (!modal) return;
            
            // Popula campos de texto
            document.getElementById('modal_project_title').textContent = projectData.title;
            document.getElementById('modal_project_client').textContent = projectData.client_name;
            document.getElementById('modal_status_label').textContent = projectData.status_label;
            document.getElementById('modal_status_label').style.backgroundColor = projectData.status_color;
            document.getElementById('modal_start_date').textContent = projectData.start_date;
            document.getElementById('modal_deadline').textContent = projectData.deadline;
            document.getElementById('modal_completed_date').textContent = projectData.completed_date;
            
            // Popula os campos financeiros
            const rawRevenue = parseFloat(projectData.total_amount) || 0;
            const taxPerc = parseFloat(projectData.tax_percentage) || 0;

            // Formata os valores originais
            document.getElementById('modal_project_revenue').textContent = formatCurrencyJS(rawRevenue, projectData.currency);
            document.getElementById('modal_project_tax_perc').textContent = `Imposto (${taxPerc.toFixed(2)}%)`;

            // [ALTERADO] Formata os valores BRL (vindos do PHP)
            document.getElementById('modal_revenue_brl').textContent = formatCurrencyJS(projectData.total_revenue_brl, 'BRL');
            document.getElementById('modal_cost_brl').textContent = formatCurrencyJS(projectData.total_cost_brl, 'BRL');
            document.getElementById('modal_tax_brl').textContent = formatCurrencyJS(projectData.total_tax_brl, 'BRL');
            document.getElementById('modal_profit_brl').textContent = formatCurrencyJS(projectData.total_profit_brl, 'BRL');
            
            // Define o link de edição
            document.getElementById('modal_edit_link').href = `projects.php?edit=${projectData.id}`;
            
            // Mostra aviso se a conversão falhou
            if (projectData.conversion_failed) {
                modalWarning.style.display = 'flex';
            } else {
                modalWarning.style.display = 'none';
            }

            modal.classList.add("active");
        }

        window.closeProjectDetailsModal = function() {
            if (modal) modal.classList.remove("active");
        }

        // Fechar modal clicando no fundo
        if (modal) {
            modal.addEventListener("click", function(e) {
                if (e.target === modal) {
                    closeProjectDetailsModal();
                }
            });
        }
        
        // Fechar modal com 'Esc'
        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape") {
                closeProjectDetailsModal();
            }
        });

    })();
</script>

