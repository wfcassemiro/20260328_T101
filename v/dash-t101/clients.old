<script>
    // --- Lógica do Alerta de Sucesso ---
    const successAlert = document.getElementById('success-alert');
    if (successAlert) {
        setTimeout(() => {
            successAlert.style.opacity = '0';
            setTimeout(() => { successAlert.remove(); }, 1000); 
        }, 5000);
    }
    
    // --- Lógica do Modal de Exclusão ---
    const deleteModal = document.getElementById('deleteModal');
    
    function showDeleteModal(clientId) {
        document.getElementById('delete_client_id').value = clientId;
        deleteModal.classList.add('active');
    }
    
    function hideDeleteModal() {
        deleteModal.classList.remove('active');
    }
    
    document.querySelectorAll('.delete-client-btn').forEach(button => {
        button.addEventListener('click', function() {
            const clientId = this.dataset.id;
            showDeleteModal(clientId);
        });
    });
    
    // Fechar modal clicando fora ou no 'x'
    deleteModal.addEventListener('click', function(e) {
        if (e.target === deleteModal || e.target.closest('.vision-modal-close')) {
            hideDeleteModal();
        }
    });
    
    // Fechar modal com 'Esc'
    document.addEventListener('keydown', function(e) {
        if (e.key === "Escape" && deleteModal.classList.contains('active')) {
            hideDeleteModal();
        }
    });

</script>

