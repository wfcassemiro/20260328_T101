<?php
session_start();
require_once __DIR__ . '/../config/database.php';
require_once __DIR__ . '/../config/dash_database.php';
require_once __DIR__ . '/../config/dash_functions.php';

// Verificar se o usuário está logado
if (!isLoggedIn()) {
    header('Location: /login.php');
    exit;
}

$user_id = $_SESSION['user_id'];
$message = '';
$error = '';
$edit_client = null;

// Processar ações do formulário (Adicionar, Editar, Excluir)
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    
    try {
        if ($action === 'add' || $action === 'edit') {
            $name = $_POST['name'];
            $email = $_POST['email'] ?? null;
            $phone = $_POST['phone'] ?? null;
            $country = $_POST['country'] ?? null;
            $notes = $_POST['notes'] ?? null;

            if (empty($name)) {
                throw new Exception("O nome do cliente é obrigatório.");
            }

            if ($action === 'add') {
                $stmt = $pdo->prepare("INSERT INTO dash_clients (user_id, name, email, phone, country, notes) VALUES (?, ?, ?, ?, ?, ?)");
                $stmt->execute([$user_id, $name, $email, $phone, $country, $notes]);
                $_SESSION['temp_message'] = "Cliente adicionado!";
            } else {
                $client_id = $_POST['client_id'];
                $stmt = $pdo->prepare("UPDATE dash_clients SET name = ?, email = ?, phone = ?, country = ?, notes = ? WHERE id = ? AND user_id = ?");
                $stmt->execute([$name, $email, $phone, $country, $notes, $client_id, $user_id]);
                $_SESSION['temp_message'] = "Cliente atualizado!";
            }
        } elseif ($action === 'delete') {
            $client_id = $_POST['client_id'];
            // (Opcional: Verificar se o cliente tem projetos antes de excluir)
            $stmt = $pdo->prepare("DELETE FROM dash_clients WHERE id = ? AND user_id = ?");
            $stmt->execute([$client_id, $user_id]);
            $_SESSION['temp_message'] = "Cliente excluído!";
        }
    } catch (Exception $e) {
        $error = $e->getMessage();
    }
    
    // Redirecionar para evitar reenvio do formulário
    if (empty($error)) {
        header("Location: clients.php");
        exit;
    }
}

// Verificar se há uma mensagem temporária na sessão
if (isset($_SESSION['temp_message'])) {
    $message = $_SESSION['temp_message'];
    unset($_SESSION['temp_message']);
}

// Lógica para carregar dados de edição (GET)
if (isset($_GET['edit'])) {
    $edit_id = (int)$_GET['edit'];
    $stmt = $pdo->prepare("SELECT * FROM dash_clients WHERE id = ? AND user_id = ?");
    $stmt->execute([$edit_id, $user_id]);
    $edit_client = $stmt->fetch(PDO::FETCH_ASSOC);
    
    if (!$edit_client) {
        header("Location: clients.php"); // ID não encontrado, redireciona
        exit;
    }
}

// Buscar todos os clientes para a lista
$stmt = $pdo->prepare("SELECT * FROM dash_clients WHERE user_id = ? ORDER BY name ASC");
$stmt->execute([$user_id]);
$clients = $stmt->fetchAll(PDO::FETCH_ASSOC);

$page_title = 'Clientes - Dash-T101';
$page_description = "Gerencie sua lista de clientes.";

// Incluir cabeçalhos
include __DIR__ . '/../vision/includes/head.php';
include __DIR__ . '/../vision/includes/header.php';
include __DIR__ . '/../vision/includes/sidebar.php';
?>

