.vision-btn { background: var(--brand-purple); color: white; border: 1px solid var(--brand-purple); border-radius: 30px; padding: 12px 24px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
