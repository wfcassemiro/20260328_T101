<script>
(function(){
    // --- Dados do PHP para o JS ---
    const freelancerPricingData = <?php echo json_encode($freelancers_pricing_json); ?>;
    const projectCurrency = '<?php echo $project_currency; ?>';
    const unitTypeMap = <?php echo json_encode($unit_types); ?>;
    const serviceTypeMap = <?php echo json_encode($service_types_list); ?>;

    // --- Elementos do Formulário de Custo/Job ---
    const freelancerIdSelect = document.getElementById('freelancer_id');
    const serviceTypeSelect = document.getElementById('service_type_job');
    const unitTypeSelect = document.getElementById('unit_type_job');
    const quantityInput = document.getElementById('quantity_job');
    const rateInput = document.getElementById('rate_job');
    const currencyJobSelect = document.getElementById('currency_job');
    const totalJobCalculatedInput = document.getElementById('total_job_calculated');

    // --- Elementos dos Modais ---
    const freelancerModal = document.getElementById('addFreelancerModal');
    const rateModal = document.getElementById('rateModal');
    const currencyWarningModal = document.getElementById('currencyWarningModal');
    const serviceModal = document.getElementById('addServiceModal'); // NOVO
    const freelancerForm = document.getElementById('freelancerForm');
    const ratesListEl = document.getElementById('rates-list');
    const pricingDataInput = document.getElementById('pricing_data_input');
    
    // --- Estado dos Modais ---
    let currentRates = [];
    
    // --- Funções de Alerta ---
    const successAlert = document.getElementById('success-alert');
    if (successAlert) {
        setTimeout(() => {
            successAlert.style.opacity = '0';
            setTimeout(() => { successAlert.remove(); }, 1000); 
        }, 5000);
    }

    // =========================================================================
    // || NOVAS Funções do Modal de Serviço                                   ||
    // =========================================================================
    window.showAddServiceModal = function(){
        serviceModal.classList.add("active");
        document.getElementById("new_service_type").focus();
    }
    window.hideAddServiceModal = function(){
        serviceModal.classList.remove("active");
        document.getElementById("new_service_type").value = "";
    }
    // =========================================================================
    // || FIM DAS NOVAS FUNÇÕES                                               ||
    // =========================================================================

    // --- Funções Principais (Cálculo e Dicas) ---
    
    function formatCurrencyForDisplay(value, currency, decimals = 2) {
        if (isNaN(value)) value = 0;
        try {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: currency, minimumFractionDigits: decimals, maximumFractionDigits: 2 }).format(value);
        } catch (e) {
            return currency + ' ' + value.toFixed(decimals);
        }
    }

    window.calculateJobTotal = function() {
        const quantity = parseFloat(quantityInput.value) || 0;
        const rate = parseFloat(rateInput.value) || 0;
        const currency = currencyJobSelect.value;
        totalJobCalculatedInput.value = formatCurrencyForDisplay(quantity * rate, currency);
    }

    window.handleRateHintAndCurrencyWarning = function() {
        const freelancerId = freelancerIdSelect.value;
        const service = serviceTypeSelect.value;
        const unit = unitTypeSelect.value;
        
        if (!freelancerId || !service || !unit) {
            rateInput.placeholder = "Custo do fornecedor";
            return;
        }

        const freelancerData = freelancerPricingData[freelancerId];
        if (!freelancerData) {
            rateInput.placeholder = "Custo do fornecedor";
            return;
        }

        const freelancerCurrency = freelancerData.currency || 'BRL';
        
        const matchingRate = freelancerData.pricing.find(r => r.unit === unit && r.service === service);
        
        if (matchingRate) {
            const formattedValue = parseFloat(matchingRate.value).toFixed(2);
            rateInput.placeholder = `Sugestão (${freelancerCurrency}): ${formattedValue}`;
            if (rateInput.value === '') {
                rateInput.value = formattedValue;
                calculateJobTotal();
            }
        } else {
            rateInput.placeholder = "Sem taxa padrão p/ este serviço";
        }
        
        const hideWarning = localStorage.getItem('hideCurrencyWarning') === 'true';
        
        if (projectCurrency !== freelancerCurrency && !hideWarning) {
            document.getElementById('freelancer-currency-warn').textContent = freelancerCurrency;
            document.getElementById('project-currency-warn').textContent = projectCurrency;
            currencyWarningModal.classList.add('active');
        }
    }

    // --- Funções dos Modais (Cadastro Rápido e Alerta) ---
    
    window.showAddFreelancerModal = function(isQuickAdd = false, freelancerData = null, redirectProjectId = null) {
        freelancerForm.reset();
        currentRates = [];
        
        if (isQuickAdd) {
            document.getElementById('freelancerModalTitle').innerHTML = '<i class="fas fa-user-plus"></i> Adicionar Novo Fornecedor';
            document.getElementById('freelancerAction').value = 'add_freelancer_from_job';
            document.getElementById('freelancerModalSubmitButton').innerHTML = '<i class="fas fa-plus"></i> Adicionar e Selecionar';
            document.getElementById('modal_project_id').value = redirectProjectId;
        }
        
        freelancerModal.classList.add('active');
        document.getElementById('new_freelancer_name').focus();
    }

    window.hideAddFreelancerModal = function() {
        freelancerModal.classList.remove('active');
    }

    window.showRateModal = function() {
        renderRatesList();
        rateModal.classList.add('active');
    }

    window.hideRateModal = function() {
        rateModal.classList.remove('active');
    }

    window.hideCurrencyWarning = function(savePreference = false) {
        if (savePreference) {
            if (document.getElementById('dont-warn-currency-again').checked) {
                localStorage.setItem('hideCurrencyWarning', 'true');
            }
        }
        currencyWarningModal.classList.remove('active');
    }
    
    function renderRatesList() {
        const currency = document.getElementById('new_freelancer_currency').value;
        ratesListEl.innerHTML = '';
        if (currentRates.length === 0) {
            ratesListEl.innerHTML = '<p class="text-muted" style="text-align: center; padding: 10px;">Nenhuma taxa adicionada.</p>';
            return;
        }
        currentRates.forEach((rate, index) => {
            const unitName = unitTypeMap[rate.unit] || rate.unit;
            const serviceName = serviceTypeMap[rate.service] || rate.service;
            const formattedValue = formatCurrencyForDisplay(rate.value, currency);
            ratesListEl.innerHTML += `
                <div class="rate-item">
                    <span class="rate-item-info">${formattedValue} por ${unitName} (${serviceName})</span>
                    <button type="button" class="rate-item-remove" onclick="removeRate(${index})"><i class="fas fa-trash"></i></button>
                </div>`;
        });
    }

    window.addRate = function() {
        const unit = document.getElementById('rate_unit').value;
        const service = document.getElementById('rate_service').value;
        const value = parseFloat(document.getElementById('rate_value').value);

        if (!unit || !service || isNaN(value) || value <= 0) {
            alert('Por favor, preencha a unidade, o serviço e um valor de taxa válido.'); return;
        }
        const exists = currentRates.some(r => r.unit === unit && r.service === service);
        if (exists) {
            alert('Já existe uma taxa configurada para esta Unidade/Serviço.'); return;
        }
        currentRates.push({ unit, service, value });
        document.getElementById('rate_value').value = '';
        renderRatesList();
    }

    window.removeRate = function(index) {
        currentRates.splice(index, 1);
        renderRatesList();
    }

    window.saveRates = function() {
        pricingDataInput.value = JSON.stringify(currentRates);
        hideRateModal();
    }

    // --- Event Listeners ---
    document.addEventListener("DOMContentLoaded", function() {
        // Preenche o formulário de job se estiver editando
        <?php if ($edit_job): ?>
            // document.querySelector('.video-card h2').scrollIntoView({ behavior: 'smooth' });
        <?php endif; ?>
        
        // Seleciona automaticamente o freelancer recém-adicionado
        <?php if ($last_added_freelancer_id): ?>
            freelancerIdSelect.value = '<?php echo $last_added_freelancer_id; ?>';
            handleRateHintAndCurrencyWarning();
        <?php endif; ?>

        // =========================================================================
        // || NOVO: Destaque para serviço recém-adicionado                        ||
        // =========================================================================
        <?php if($new_service_added):?>
        setTimeout(function(){
            const e=document.getElementById("service_type_job");
            e.style.boxShadow="0 0 0 3px rgba(34, 197, 94, 0.3)";
            e.style.borderColor="#22c55e";
            setTimeout(function(){e.style.boxShadow="",e.style.borderColor=""}, 2000);
        }, 500);
        <?php endif;?>


        // Listeners do formulário de Custo/Job
        freelancerIdSelect.addEventListener('change', handleRateHintAndCurrencyWarning);
        serviceTypeSelect.addEventListener('change', handleRateHintAndCurrencyWarning);
        unitTypeSelect.addEventListener('change', handleRateHintAndCurrencyWarning);
        currencyJobSelect.addEventListener('change', calculateJobTotal);
        
        // Listeners para fechar modais
        freelancerModal.addEventListener("click", function(e) { if (e.target === this) { hideAddFreelancerModal(); } });
        rateModal.addEventListener("click", function(e) { if (e.target === this) { hideRateModal(); } });
        currencyWarningModal.addEventListener("click", function(e) { if (e.target === this) { hideCurrencyWarning(); } });
        serviceModal.addEventListener("click", function(e) { if (e.target === this) { hideAddServiceModal(); } }); // NOVO
        
        document.addEventListener("keydown", function(e) {
            if (e.key === "Escape") {
                if (currencyWarningModal.classList.contains('active')) hideCurrencyWarning();
                else if (rateModal.classList.contains('active')) hideRateModal();
                else if (freelancerModal.classList.contains('active')) hideAddFreelancerModal();
                else if (serviceModal.classList.contains('active')) hideAddServiceModal(); // NOVO
            }
        });

        // Dispara os cálculos e hints ao carregar a página (caso esteja editando)
        calculateJobTotal();
        handleRateHintAndCurrencyWarning();
    });
})();
</script>

<?php
include __DIR__ . '/../vision/includes/footer.php';
?>