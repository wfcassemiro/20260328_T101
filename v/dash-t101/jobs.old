<?php
session_start();
require_once __DIR__ . '/../config/database.php';
require_once __DIR__ . '/../config/dash_database.php';
require_once __DIR__ . '/../config/dash_functions.php'; // Incluído

if (!isLoggedIn()) {
    header('Location: /login.php?redirect=' . urlencode($_SERVER['REQUEST_URI']));
    exit;
}

$user_id = $_SESSION['user_id'];
$project_id = $_GET['project_id'] ?? null;
$message = '';
$error = '';

if (!$project_id) {
    header('Location: projects.php');
    exit;
}

// Listas para modais
$languages = ['pt' => 'Português', 'en' => 'Inglês', 'es' => 'Espanhol', 'fr' => 'Francês', 'de' => 'Alemão', 'it' => 'Italiano', 'ja' => 'Japonês', 'ko' => 'Coreano', 'zh' => 'Chinês', 'ru' => 'Russo', 'ar' => 'Árabe'];
$unit_types = ['palavra' => 'Palavra', 'caracteres' => 'Caracteres', 'hora' => 'Hora', 'minuto' => 'Minuto', 'lauda' => 'Lauda', 'diaria' => 'Diária'];
$service_types_list = ['traducao' => 'Tradução', 'revisao' => 'Revisão', 'localizacao' => 'Localização', 'interpretacao' => 'Interpretação', 'transcricao' => 'Transcrição', 'other' => 'Outros'];

// =========================================================================
// || NOVO: Lógica para Adicionar Serviço Customizado (da Sessão)         ||
// =========================================================================
$new_service_added = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'add_service_type') {
    $new_service = trim($_POST['new_service_type']);
    if (!empty($new_service)) {
        if (!isset($_SESSION['custom_services'])) {
            $_SESSION['custom_services'] = [];
        }
        $normalized_new_service = strtolower($new_service);
        // Evitar duplicatas
        $normalized_custom_services = array_map('strtolower', $_SESSION['custom_services']);
        if (!in_array($normalized_new_service, $normalized_custom_services)) {
            $_SESSION['custom_services'][] = $new_service;
            $new_service_added = $new_service;
            $_SESSION['temp_message'] = "Novo serviço '$new_service' adicionado.";
        } else {
            $new_service_added = $new_service; // Para selecionar
            $_SESSION['temp_message'] = "Serviço '$new_service' já existe.";
        }
    }
    // Recarregar a página para mostrar o novo serviço e a mensagem
    header("Location: jobs.php?project_id=" . $project_id);
    exit;
}


// Processar ações POST (Adicionar, Editar, Excluir Custo/Job)
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    try {
        switch ($_POST['action']) {
            case 'add_job':
                $freelancer_id = $_POST['freelancer_id'];
                $service_type = $_POST['service_type'];
                $unit_type = $_POST['unit_type'];
                $quantity = floatval($_POST['quantity'] ?? 0);
                $rate = floatval($_POST['rate'] ?? 0);
                $currency = $_POST['currency']; // Moeda do custo
                $total_cost = $quantity * $rate;
                $deadline = $_POST['deadline'] ?: null;
                $status = $_POST['status'];
                $notes = $_POST['notes'] ?? '';

                $stmt = $pdo->prepare("INSERT INTO dash_jobs (user_id, project_id, freelancer_id, service_type, unit_type, quantity, rate, currency, total_cost, deadline, status, notes) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
                $stmt->execute([$user_id, $project_id, $freelancer_id, $service_type, $unit_type, $quantity, $rate, $currency, $total_cost, $deadline, $status, $notes]);
                $message = "Custo/Tarefa adicionado ao projeto.";
                break;

            case 'edit_job':
                $job_id = $_POST['job_id'];
                $freelancer_id = $_POST['freelancer_id'];
                $service_type = $_POST['service_type'];
                $unit_type = $_POST['unit_type'];
                $quantity = floatval($_POST['quantity'] ?? 0);
                $rate = floatval($_POST['rate'] ?? 0);
                $currency = $_POST['currency'];
                $total_cost = $quantity * $rate;
                $deadline = $_POST['deadline'] ?: null;
                $status = $_POST['status'];
                $notes = $_POST['notes'] ?? '';

                $stmt = $pdo->prepare("UPDATE dash_jobs SET freelancer_id = ?, service_type = ?, unit_type = ?, quantity = ?, rate = ?, currency = ?, total_cost = ?, deadline = ?, status = ?, notes = ? WHERE id = ? AND user_id = ? AND project_id = ?");
                $stmt->execute([$freelancer_id, $service_type, $unit_type, $quantity, $rate, $currency, $total_cost, $deadline, $status, $notes, $job_id, $user_id, $project_id]);
                $message = "Custo/Tarefa atualizado.";
                break;

            case 'delete_job':
                $job_id = $_POST['job_id'];
                $stmt = $pdo->prepare("DELETE FROM dash_jobs WHERE id = ? AND user_id = ? AND project_id = ?");
                $stmt->execute([$job_id, $user_id, $project_id]);
                $message = "Custo/Tarefa excluído.";
                break;
        }
    } catch (PDOException $e) {
        $error = 'Erro no banco de dados: ' . $e->getMessage();
    }
}

// Lógica para selecionar freelancer recém-adicionado (pós-redirect)
$last_added_freelancer_id = null;
if (isset($_SESSION['last_added_freelancer_id'])) {
    $last_added_freelancer_id = $_SESSION['last_added_freelancer_id'];
    $message = isset($_SESSION['temp_message']) ? $_SESSION['temp_message'] : "Novo fornecedor adicionado e selecionado.";
    unset($_SESSION['last_added_freelancer_id']);
    if (isset($_SESSION['temp_message'])) unset($_SESSION['temp_message']);
}
if(isset($_SESSION['temp_message'])) {
    $message = $_SESSION['temp_message'];
    unset($_SESSION['temp_message']);
}
if(isset($_SESSION['temp_error'])) {
    $error = $_SESSION['temp_error'];
    unset($_SESSION['temp_error']);
}


// --- BUSCAR DADOS PARA A PÁGINA ---

// 1. Buscar detalhes do Projeto (Receita)
$stmt = $pdo->prepare("SELECT p.*, p.title AS project_name, c.company AS company_name FROM dash_projects p LEFT JOIN dash_clients c ON p.client_id = c.id WHERE p.id = ? AND p.user_id = ?");
$stmt->execute([$project_id, $user_id]);
$project = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$project) {
    header('Location: projects.php');
    exit;
}
$total_revenue = $project['total_amount'];
$project_currency = $project['currency']; // Moeda principal do projeto

// 2. Buscar Tarefas/Custos (Jobs)
$stmt = $pdo->prepare("SELECT j.*, f.name AS freelancer_name FROM dash_jobs j JOIN dash_freelancers f ON j.freelancer_id = f.id WHERE j.project_id = ? AND j.user_id = ? ORDER BY j.created_at DESC");
$stmt->execute([$project_id, $user_id]);
$jobs = $stmt->fetchAll(PDO::FETCH_ASSOC);

// 3. Calcular Custos e Lucro
$total_cost = 0;
foreach ($jobs as $job) {
    if ($job['currency'] == $project_currency) {
        $total_cost += $job['total_cost'];
    }
}
$profit = $total_revenue - $total_cost;

// 4. Buscar Freelancers (para o <select> e para o JS)
$stmt = $pdo->prepare("SELECT id, name, pricing_structure, currency FROM dash_freelancers WHERE user_id = ? AND is_active = 1 ORDER BY name ASC");
$stmt->execute([$user_id]);
$freelancers_list = $stmt->fetchAll(PDO::FETCH_ASSOC);

// 5. Preparar dados de preço para o JavaScript
$freelancers_pricing_json = [];
foreach ($freelancers_list as $data) {
    $freelancers_pricing_json[$data['id']] = [
        'pricing' => json_decode($data['pricing_structure'] ?? '[]', true),
        'currency' => $data['currency'] // Moeda do *fornecedor*
    ];
}

// 6. Buscar Job para Edição (se solicitado)
$edit_job = null;
if (isset($_GET['edit_job']) && is_numeric($_GET['edit_job'])) {
    $stmt = $pdo->prepare("SELECT * FROM dash_jobs WHERE id = ? AND user_id = ?");
    $stmt->execute([$_GET['edit_job'], $user_id]);
    $edit_job = $stmt->fetch(PDO::FETCH_ASSOC);
}


$page_title = "Custos do Projeto - Dash-T101";
include __DIR__ . '/../vision/includes/head.php';
include __DIR__ . '/../vision/includes/header.php';
include __DIR__ . '/../vision/includes/sidebar.php';
?>

