    $stmt->execute();
    $settings = $stmt->fetchAll(PDO::FETCH_KEY_PAIR);
    
    $live_embed_code = $settings['live_embed_code'] ?? '';
    $chat_embed_code = $settings['chat_embed_code'] ?? '';
    $live_status = $settings['live_status'] ?? '0';
