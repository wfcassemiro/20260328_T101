                        ]));
                        ?>
                        <?php if ($i == $page): ?>
                            <span class="cta-btn current-page"><?php echo $i; ?></span>
                        <?php else: ?>
                            <a href="?<?php echo $url_params; ?>" class="page-btn"><?php echo $i; ?></a>
                        <?php endif; ?>
                    <?php endfor; ?>
                </div>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</div>

<script>
function updateSelectedCount() {
    const checked = document.querySelectorAll('.lead-checkbox:checked');
    const count   = checked.length;
    document.getElementById('selectedCount').textContent = count;
    const btn = document.getElementById('sendEmailSelectedBtn');
    btn.style.display = count > 0 ? 'inline-flex' : 'none';
}

function toggleAllCheckboxes(source) {
    const checkboxes = document.querySelectorAll('.lead-checkbox');
    checkboxes.forEach(cb => cb.checked = source.checked);
    updateSelectedCount();
}

function selectAllExpired() {
    const checkboxes = document.querySelectorAll('.lead-checkbox');
    checkboxes.forEach(cb => cb.checked = true);
    const master = document.getElementById('checkboxAll');
    if (master) master.checked = true;
    updateSelectedCount();
}

function deselectAll() {
    const checkboxes = document.querySelectorAll('.lead-checkbox');
    checkboxes.forEach(cb => cb.checked = false);
    const master = document.getElementById('checkboxAll');
    if (master) master.checked = false;
    updateSelectedCount();
}

function sendSelectedToEmails() {
    const checked = document.querySelectorAll('.lead-checkbox:checked');
    if (checked.length === 0) {
        alert('Selecione pelo menos um lead para enviar email.');
        return;
    }
    
    const selectedLeads = [];
    checked.forEach(cb => {
        selectedLeads.push({
            id:    cb.dataset.id,
            name:  cb.dataset.name,
            email: cb.dataset.email
        });
    });
    
    // Salva para o emails.php
    localStorage.setItem('t101_leads_fundo_selected', JSON.stringify(selectedLeads));
    localStorage.setItem('t101_source', 'leads_fundo');
    
    window.location.href = 'emails.php';
}
</script>

