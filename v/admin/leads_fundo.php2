// Verificar se é admin
if (!isset($_SESSION['user_id']) || !isset($_SESSION['is_admin']) || !$_SESSION['is_admin']) {
    header('Location: /login.php');
    exit;
}

$page_title = 'Leads trial - Admin';
$message = '';
$error = '';

// Função para calcular status do trial
function calcularStatusTrial($user) {
    // Se não foi aprovado ainda
    if (empty($user['trial_approved'])) {
        return [
            'status' => 'pending',
            'label' => 'Aguardando aprovação',
            'class' => 'status-warning',
            'icon' => 'fa-clock'
        ];
    }
    
    // Se não iniciou o trial ainda
    if (empty($user['trial_started_at'])) {
        return [
            'status' => 'approved',
            'label' => 'Aprovado (não iniciado)',
            'class' => 'status-info',
            'icon' => 'fa-check-circle'
        ];
    }
    
    $now = new DateTime();
    $trialStarted = new DateTime($user['trial_started_at']);
    
    if ($user['role'] === 'trial_7d') {
        $expirationDate = clone $trialStarted;
        $expirationDate->modify('+7 days');
        
        if ($now > $expirationDate) {
            return [
                'status' => 'expired',
                'label' => 'Expirado',
                'class' => 'status-error',
                'icon' => 'fa-times-circle',
                'expired_at' => $expirationDate->format('Y-m-d H:i:s')
            ];
        } else {
            $interval = $now->diff($expirationDate);
            return [
                'status' => 'active',
                'label' => "Ativo ({$interval->days}d {$interval->h}h)",
                'class' => 'status-completed',
                'icon' => 'fa-play-circle',
                'expires_at' => $expirationDate->format('d/m/Y H:i')
            ];
        }
    } else { // trial_24h
        $expirationDate = clone $trialStarted;
        $expirationDate->modify('+24 hours');
        
        $lecturesWatched = json_decode($user['trial_lectures_watched'] ?? '[]', true);
        $lecturesCount = is_array($lecturesWatched) ? count($lecturesWatched) : 0;
        
        if ($now > $expirationDate) {
            return [
                'status' => 'expired',
                'label' => 'Expirado (24h)',
                'class' => 'status-error',
                'icon' => 'fa-times-circle',
                'expired_at' => $expirationDate->format('Y-m-d H:i:s'),
                'lectures' => $lecturesCount
            ];
        } else {
            $interval = $now->diff($expirationDate);
            return [
                'status' => 'active',
                'label' => "Ativo ({$interval->h}h {$interval->i}min)",
                'class' => 'status-completed',
                'icon' => 'fa-play-circle',
                'expires_at' => $expirationDate->format('d/m/Y H:i'),
                'lectures' => $lecturesCount
            ];
        }
    }
}

// Processar exportação CSV
if (isset($_GET['export']) && $_GET['export'] === 'csv') {
    try {
        $filter = $_GET['filter'] ?? 'all';
        $status_filter = $_GET['status'] ?? 'all';
        
        // Buscar usuários trial da tabela users
        $where_conditions = ["role IN ('trial_7d', 'trial_24h')"];
        
        if ($filter === 'trial_7d') {
            $where_conditions[] = "role = 'trial_7d'";
        } elseif ($filter === 'trial_24h') {
            $where_conditions[] = "role = 'trial_24h'";
        }
        
        $where_clause = 'WHERE ' . implode(' AND ', $where_conditions);
        
        $stmt = $pdo->query("
            SELECT id, name, email, role, whatsapp, trial_approved, trial_started_at, 
                   trial_lectures_watched, created_at
            FROM users
            {$where_clause}
            ORDER BY created_at DESC
        ");
        $users = $stmt->fetchAll(PDO::FETCH_ASSOC);
        
        // Também buscar da tabela leads_fundo (expirados que já foram movidos)
        $leads_fundo = [];
        try {
            $stmt2 = $pdo->query("SELECT * FROM leads_fundo ORDER BY expired_at DESC");
            $leads_fundo = $stmt2->fetchAll(PDO::FETCH_ASSOC);
        } catch (Exception $e) {
            // Tabela pode não existir ainda
        }
        
        // Gerar CSV
        header('Content-Type: text/csv; charset=utf-8');
        header('Content-Disposition: attachment; filename="leads_trial_' . date('Y-m-d_H-i-s') . '.csv"');
        
        $output = fopen('php://output', 'w');
        fprintf($output, chr(0xEF).chr(0xBB).chr(0xBF));
        
        fputcsv($output, ['Nome', 'Email', 'WhatsApp', 'Tipo trial', 'Status', 'Criado em', 'Palestras'], ';');
        
        foreach ($users as $user) {
            $statusInfo = calcularStatusTrial($user);
            $lectures = json_decode($user['trial_lectures_watched'] ?? '[]', true);
            
            fputcsv($output, [
                $user['name'],
                $user['email'],
                $user['whatsapp'] ?? '',
                $user['role'] === 'trial_7d' ? '7 dias' : '24h (3 palestras)',
                $statusInfo['label'],
                date('d/m/Y H:i', strtotime($user['created_at'])),
                is_array($lectures) ? count($lectures) : 0
            ], ';');
        }
        
        // Adicionar leads_fundo ao export
        foreach ($leads_fundo as $lead) {
            // Verificar se já não está nos users
            $exists = false;
            foreach ($users as $u) {
                if ($u['email'] === $lead['email']) {
                    $exists = true;
                    break;
                }
            }
            if (!$exists) {
                fputcsv($output, [
                    $lead['nome'],
                    $lead['email'],
                    '', // whatsapp não existe em leads_fundo
                    $lead['trial_type'] === 'trial_7d' ? '7 dias' : '24h (3 palestras)',
                    'Expirado (convertido)',
                    date('d/m/Y H:i', strtotime($lead['expired_at'])),
                    $lead['lectures_watched'] ?? 0
                ], ';');
            }
        }
        
        fclose($output);
        exit;
        
    } catch (Exception $e) {
        $error = 'Erro ao exportar: ' . $e->getMessage();
    }
}

// Processar ações
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    
    try {
        if ($action === 'approve_trial') {
            $user_id = $_POST['user_id'] ?? '';
            $stmt = $pdo->prepare("
                UPDATE users 
                SET trial_approved = 1, 
                    trial_approved_at = NOW(),
                    trial_started_at = NOW()
                WHERE id = ?
            ");
            $stmt->execute([$user_id]);
            $message = 'Trial aprovado e iniciado com sucesso!';
        }
        
        if ($action === 'toggle_email') {
            $lead_id = $_POST['lead_id'] ?? '';
            $stmt = $pdo->prepare("UPDATE leads_fundo SET pode_receber_email = NOT pode_receber_email WHERE id = ?");
            $stmt->execute([$lead_id]);
            $message = 'Status de email atualizado!';
        }
        
        if ($action === 'delete_user') {
            $user_id = $_POST['user_id'] ?? '';
            $stmt = $pdo->prepare("DELETE FROM users WHERE id = ? AND role IN ('trial_7d', 'trial_24h')");
            $stmt->execute([$user_id]);
            $message = 'Usuário trial removido!';
        }
        
        if ($action === 'delete_lead') {
            $lead_id = $_POST['lead_id'] ?? '';
            $stmt = $pdo->prepare("DELETE FROM leads_fundo WHERE id = ?");
            $stmt->execute([$lead_id]);
            $message = 'Lead removido com sucesso!';
        }
    } catch (PDOException $e) {
        $error = 'Erro: ' . $e->getMessage();
    }
}

// Buscar dados com filtros
$filter = $_GET['filter'] ?? 'all';
$status_filter = $_GET['status'] ?? 'all';
$search = $_GET['search'] ?? '';
$page = max(1, (int)($_GET['page'] ?? 1));
$per_page = 50;
$offset = ($page - 1) * $per_page;

try {
    // Buscar usuários trial da tabela users
    $where_conditions = ["role IN ('trial_7d', 'trial_24h')"];
    $params = [];
    
    if ($filter === 'trial_7d') {
        $where_conditions[] = "role = 'trial_7d'";
    } elseif ($filter === 'trial_24h') {
        $where_conditions[] = "role = 'trial_24h'";
    }
    
    if ($search) {
        $where_conditions[] = "(name LIKE ? OR email LIKE ?)";
        $params[] = "%{$search}%";
        $params[] = "%{$search}%";
    }
    
    $where_clause = 'WHERE ' . implode(' AND ', $where_conditions);
    
    // Buscar todos os usuários trial
    $stmt = $pdo->prepare("
        SELECT id, name, email, role, whatsapp, trial_approved, trial_started_at, 
               trial_lectures_watched, created_at
        FROM users
        {$where_clause}
        ORDER BY created_at DESC
    ");
    $stmt->execute($params);
    $all_users = $stmt->fetchAll(PDO::FETCH_ASSOC);
    
    // Calcular status de cada usuário
    $users_with_status = [];
    foreach ($all_users as $user) {
        $user['status_info'] = calcularStatusTrial($user);
        $users_with_status[] = $user;
    }
    
    // Filtrar por status se necessário
    if ($status_filter !== 'all') {
        $users_with_status = array_filter($users_with_status, function($u) use ($status_filter) {
            return $u['status_info']['status'] === $status_filter;
        });
        $users_with_status = array_values($users_with_status);
    }
    
    // Paginação
    $total_filtered = count($users_with_status);
    $total_pages = ceil($total_filtered / $per_page);
    $users = array_slice($users_with_status, $offset, $per_page);
    
    // Estatísticas
    $stats = [
        'total' => count($all_users),
        'pending' => 0,
        'active' => 0,
        'expired' => 0,
        'approved' => 0,
        'trial_7d' => 0,
        'trial_24h' => 0
    ];
    
    foreach ($all_users as $u) {
        $s = calcularStatusTrial($u);
        $stats[$s['status']]++;
        if ($u['role'] === 'trial_7d') $stats['trial_7d']++;
        if ($u['role'] === 'trial_24h') $stats['trial_24h']++;
    }
    
    // Buscar também da tabela leads_fundo para estatísticas
    $leads_fundo_count = 0;
    try {
        $stmt = $pdo->query("SELECT COUNT(*) FROM leads_fundo");
        $leads_fundo_count = $stmt->fetchColumn();
    } catch (Exception $e) {
        // Tabela pode não existir
    }
    
} catch (PDOException $e) {
    $users = [];
    $total_filtered = 0;
    $total_pages = 0;
    $stats = [
        'total' => 0,
        'pending' => 0,
        'active' => 0,
        'expired' => 0,
        'approved' => 0,
        'trial_7d' => 0,
        'trial_24h' => 0
    ];
    $leads_fundo_count = 0;
    $error = 'Erro ao carregar dados: ' . $e->getMessage();
}

